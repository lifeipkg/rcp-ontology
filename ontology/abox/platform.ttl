@prefix rcp:  <https://risk-control.platform/ontology#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# ─────────────────────────────────────────────────────────────────────────────
# 平台配置：标识、基座版本钉、服务发现。
#
# 这些是平台级单点事实，全工作区只有这一份。消费方式（工作区根）：
#   python rcp-ontology/checker/cli.py render --out SERVICES.md
# 或读本文件：
#   grep -A6 'rcp:stack' rcp-ontology/ontology/abox/platform.ttl
#
# 基座版本：服务侧必须对齐，禁止各仓自行抬版本。
# 现役服务全部为 Go：go 1.22 + gin 1.10.0，由各仓 go.mod 钉住，不得自行抬版本。
# Java 基线字段仅作历史登记保留，当前无 Java 服务在用。
#
# 服务发现：消费方按服务名解析地址，不在部署清单里写死上游 URL（见 RL-007）。
#   discoveryState 取值：
#     declared —— 形态已声明、基础设施清单已就位，尚未按名解析
#     wired    —— 服务已按 name 解析，清单中不再出现上游地址
#   注：Go 服务不注册 Nacos，按 k8s DNS 解析（fallback），满足"清单不写上游地址"，
#   但不在注册中心有实例视图。
# ─────────────────────────────────────────────────────────────────────────────

rcp:platform
    a rcp:Platform ;
    rcp:registrySchema "rcp.registry/v2" ;
    rcp:platformName "risk-control-platform" ;
    rcp:updated "2026-11-08"^^xsd:date ;
    rcp:stack [
        rcp:go "1.22" ;
        rcp:gin "1.10.0"
    ] ;
    rcp:discovery [
        rcp:discoveryKind "k8s-dns" ;
        rcp:discoveryState "wired" ;
        rcp:namespace "risk-control" ;
        rcp:fallback "k8s-dns" ;
        rcp:note "全部服务均为 Go 实现（api-gateway/iam/dataway/db-ops），不注册 Nacos，按部署侧 Service 名经 DNS 解析（fallback 即 k8s-dns）。满足 RL-007：清单中不出现上游地址。网关对 IAM 的调用是逐请求内省（iam.auth 的唯一判定点），IAM 不可用时鉴权 fail closed。本平台为 demo 定位，未做运行时标定，行为验证以各仓单测（go test）为准，见 rcp-contracts/docs/DISCOVERY.md。" ;
        rdfs:comment "服务发现的形态与进度。state=wired 表示运行时代码已按服务名解析；Go 侧走 k8s-dns，不注册 Nacos。" ;
    ] .
