@prefix rcp: <https://risk-control.platform/ontology#> .
@prefix sh:  <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# SHACL 约束（shapes）。把"能表达为图形状约束"的红线翻译成 W3C 标准语言，
# 与 checks.py 形成对照。文件扫描类红线（RL-004/005/007）不在 SHACL 能力内，
# 仍由 checks.py 承担。

# 服务必须有 port（对应 E001 必填字段的 port 部分）
rcp:ServiceShape a sh:NodeShape ;
    sh:targetClass rcp:Service ;
    sh:property [
        sh:path rcp:port ;
        sh:minCount 1 ;
        sh:message "服务必须有 port（E001）" ;
    ] .

# 巡查线不得依赖巡查线（对应 RL-001：巡查线之间不得互相调用）
rcp:PatrolLineShape a sh:NodeShape ;
    sh:targetClass rcp:PatrolLine ;
    sh:property [
        sh:path rcp:dependsOn ;
        sh:class rcp:PatrolLine ;
        sh:maxCount 0 ;
        sh:message "巡查线不得互相调用（RL-001）" ;
    ] .

# 能力命名符合点分小写规范（对应 E114）
rcp:CapabilityShape a sh:NodeShape ;
    sh:targetClass rcp:Capability ;
    sh:property [
        sh:path rcp:name ;
        sh:pattern "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)+$" ;
        sh:message "能力名不符合点分小写规范（E114）" ;
    ] .
