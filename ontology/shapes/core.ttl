@prefix rcp: <https://risk-control.platform/ontology#> .
@prefix sh:  <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ─────────────────────────────────────────────────────────────────────────────
# SHACL 约束（shapes）。分两类：
#
#   静态（本文件）：不随 TBox 内容变化的「固定结构约束」。
#       目标类、路径、必填与否都是固定的，与 kinds/capabilities 的具体条目无关。
#   动态（checker/shapes.py）：白名单、external 方向、port/contract 是否必填，
#       参数来自 tbox/kinds.ttl 的每个 kind，随数据而变。
#
# 不在 SHACL 能力内的判定仍由 checks.py 承担：文件扫描类红线（RL-004/005/007）、
# 键存在性（E001 其余字段）、唯一键（E002）、能力命名（E114）、
# 能力归属（E111/E112）、expected 形状（E115）、图连通性（E108/E109/E110）。
# 边界见 README。
# ─────────────────────────────────────────────────────────────────────────────

# ---- E105：依赖必须指向已登记的服务（dependsOn 对象必须是 rcp:Service） ----
rcp:RegisteredDependencyShape a sh:NodeShape ;
    sh:targetClass rcp:Service ;
    sh:property [
        sh:path rcp:dependsOn ;
        sh:class rcp:Service ;
        sh:message "E105: 依赖了未登记的服务" ;
    ] .

# ---- E201：服务种类必须是已声明的 kind（rdf:type 里至少一个是 rcp:Kind 实例） ----
# exporter 为每个已声明 kind 挂 rcp:Kind；未声明的 kind 类没有该类型，故 minCount 1
# 能捕获「服务用了 TBox 里不存在的种类」。
rcp:DeclaredKindShape a sh:NodeShape ;
    sh:targetClass rcp:Service ;
    sh:property [
        sh:path rdf:type ;
        sh:qualifiedValueShape [ sh:class rcp:Kind ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "E201: 服务种类未在 TBox 声明" ;
    ] .

# ---- E202：能力必须已立名（hasCapability 对象必须是 rcp:Capability） ----
rcp:DeclaredCapabilityShape a sh:NodeShape ;
    sh:targetClass rcp:Service, rcp:Library ;
    sh:property [
        sh:path rcp:hasCapability ;
        sh:class rcp:Capability ;
        sh:message "E202: 使用了未立名的能力" ;
    ] .

# ---- E113：TBox 自洽 —— kind 的四个布尔属性必须显式写全（决定检查器行为） ----
rcp:KindIntegrityShape a sh:NodeShape ;
    sh:targetClass rcp:Kind ;
    sh:property [
        sh:path rcp:mustBeExternal ;
        sh:minCount 1 ;
        sh:datatype xsd:boolean ;
        sh:message "E113: kind 缺布尔属性 must_be_external" ;
    ] , [
        sh:path rcp:isEntry ;
        sh:minCount 1 ;
        sh:datatype xsd:boolean ;
        sh:message "E113: kind 缺布尔属性 is_entry" ;
    ] , [
        sh:path rcp:requiresPort ;
        sh:minCount 1 ;
        sh:datatype xsd:boolean ;
        sh:message "E113: kind 缺布尔属性 requires_port" ;
    ] , [
        sh:path rcp:requiresContract ;
        sh:minCount 1 ;
        sh:datatype xsd:boolean ;
        sh:message "E113: kind 缺布尔属性 requires_contract" ;
    ] , [
        sh:path rcp:allowsDependsOn ;
        sh:class rcp:Kind ;
        sh:message "E113: allowed_depends_on_kinds 引用了未声明的种类" ;
    ] .

# ---- E114 已移出 SHACL ----
# TBox 迁到 TTL 后，能力名就是实例 IRI 的 local name，图上没有 rcp:name 字面值可挂
# sh:pattern。留一个永远不命中的形状比没有检查更危险，故该判定移回 checks.py
# （check_capability_naming），由字典视图上的正则承担。

# ---- E210：架构资产必须有归属（团队） ----
# 资产类不挂 rcp:Service，所以服务侧的 E001 owner 必填不覆盖它们。
# LifecycleState 是词汇不是资产，不进 targetClass。
rcp:ArchAssetOwnerShape a sh:NodeShape ;
    sh:targetClass rcp:Team, rcp:Contract, rcp:Table, rcp:Datastore, rcp:Workload,
                   rcp:Pipeline, rcp:Gate, rcp:Environment, rcp:Namespace, rcp:TrustBoundary,
                   rcp:Component ;
    sh:property [
        sh:path rcp:owner ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "E210: 架构资产缺 owner，归属无法落到审批" ;
    ] .

# ---- E211：契约资产必须有路径与版本 ----
# 路径是「与磁盘对表」的锚点，版本是「破坏性变更」判据的输入；缺任一项，
# 契约在图上是不可核对的节点。
rcp:ContractAssetShape a sh:NodeShape ;
    sh:targetClass rcp:Contract ;
    sh:property [
        sh:path rcp:path ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "E211: 契约缺 path，无法与磁盘对表" ;
    ] , [
        sh:path rcp:version ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "E211: 契约缺 version，破坏性变更无从判定" ;
    ] .

# ---- E212：工作负载必须声明所属环境 ----
# 没有环境的 workload 无法回答「这个部署单元在本地还是生产」，也就不该被登记。
rcp:WorkloadPlacementShape a sh:NodeShape ;
    sh:targetClass rcp:Workload ;
    sh:property [
        sh:path rcp:deployed_to ;
        sh:minCount 1 ;
        sh:class rcp:Environment ;
        sh:message "E212: 工作负载未声明所属环境" ;
    ] .

# ---- E213：ADR 必须带决策与决策日期 ----
# 空 ADR 只是标题，撑不起「红线的出处」。当前无实例，形状空转即正确行为。
rcp:AdrShape a sh:NodeShape ;
    sh:targetClass rcp:Adr ;
    sh:property [
        sh:path rcp:decision ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "E213: ADR 缺 decision 正文" ;
    ] , [
        sh:path rcp:decidedOn ;
        sh:minCount 1 ;
        sh:datatype xsd:date ;
        sh:message "E213: ADR 缺 decidedOn 日期" ;
    ] .
