@prefix rcp:  <https://risk-control.platform/ontology#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# ─────────────────────────────────────────────────────────────────────────────
# 能力（capability）。
#
# 服务登记里出现的 rcp:hasCapability 目标必须在此立名（E202）；owner 必须是真正
# 持有它的服务或库（E111/E112），否则审批与责任会落在不实现该能力的人身上。
#
# 命名规范（E114）：点分小写，如 iam.auth。能力名即实例 IRI 的 local name，
# 不再另写 rcp:name —— 同一事实只有一个位置。
# ─────────────────────────────────────────────────────────────────────────────

rcp:iam.auth a rcp:Capability ;
    rdfs:label "身份认证" ;
    rcp:definition "用户名口令登录、会话签发、令牌内省与吊销；令牌有效性只在 IAM 判定。" ;
    rcp:implementedBy rcp:iam .

rcp:iam.users a rcp:Capability ;
    rdfs:label "用户与角色" ;
    rcp:definition "用户生命周期与角色授予（ADMIN / OPERATOR / VIEWER），含最后一个管理员保护。" ;
    rcp:implementedBy rcp:iam .

# 多租户化后从 iam.users 拆出的三项：租户边界、角色与授权、权限码目录各由一条能力承载，
# 便于按能力反查负责方与影响面。
rcp:iam.tenants a rcp:Capability ;
    rdfs:label "租户管理" ;
    rcp:definition "租户的开通、停用与查询；租户本身即隔离边界，本能力不提供跨租户用户数据。" ;
    rcp:implementedBy rcp:iam .

rcp:iam.roles a rcp:Capability ;
    rdfs:label "角色与授权" ;
    rcp:definition "租户内角色定义、权限码绑定与用户角色授予；角色→权限的展开只在本服务内。" ;
    rcp:implementedBy rcp:iam .

rcp:iam.permissions a rcp:Capability ;
    rdfs:label "权限码目录" ;
    rcp:definition "平台预置权限码的只读目录，供角色编辑与前端可见性判断使用。" ;
    rcp:implementedBy rcp:iam .

rcp:data.query a rcp:Capability ;
    rdfs:label "声明式查询" ;
    rcp:definition "只读查询，限 SELECT 且限白名单表。" ;
    rcp:implementedBy rcp:dataway .

rcp:data.execute a rcp:Capability ;
    rdfs:label "模板写入" ;
    rcp:definition "按服务端登记模板执行写入，拒绝裸 DML。" ;
    rcp:implementedBy rcp:dataway .

rcp:schema.migrate a rcp:Capability ;
    rdfs:label "迁移执行" ;
    rcp:definition "按版本顺序执行 DDL 迁移。" ;
    rcp:implementedBy rcp:db-ops .

rcp:schema.version a rcp:Capability ;
    rdfs:label "版本台账" ;
    rcp:definition "提供已应用/待应用版本查询。" ;
    rcp:implementedBy rcp:db-ops .

rcp:ops.console a rcp:Capability ;
    rdfs:label "运营控制台" ;
    rcp:definition "运营前端，经网关访问后端。" ;
    rcp:implementedBy rcp:web .
