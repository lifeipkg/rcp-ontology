@prefix rcp:  <https://risk-control.platform/ontology#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# ─────────────────────────────────────────────────────────────────────────────
# 决策等级 —— 处置语义的**唯一真源**。
#
# 这里同时承载四件事：码（IRI local name）、中文名（rdfs:label）、基准分
# （rcp:baseScore）、语义（rcp:meaning）。任何一处改动只改本文件。
#
# 对端（全部是派生或受检对象，不得反向成为真源）：
#   rcp-core 的 Decision 枚举与 baseScore()   —— 实现侧，必须逐字一致（RL-003）
#   contracts/schemas/decision.yaml           —— 生成物，由 cli.py render-schema 产出
#   其余 OpenAPI / schema                     —— 只允许 $ref，不得内联枚举（RL-003）
#
# 顺序即分值升序：RL-003 逐字比对依赖稳定顺序，装载器按 baseScore 排序。
# ─────────────────────────────────────────────────────────────────────────────

rcp:PASS a rcp:Decision ;
    rdfs:label "放行" ;
    rcp:baseScore 0 ;
    rcp:meaning "未命中或命中但无风险，正常分发。" .

rcp:WARN a rcp:Decision ;
    rdfs:label "提示" ;
    rcp:baseScore 20 ;
    rcp:meaning "存在风险信号但不拦截，仅对当事人提示（如求职侧命中诱导话术）。" .

rcp:LIMIT a rcp:Decision ;
    rdfs:label "限流" ;
    rcp:baseScore 40 ;
    rcp:meaning "限制触达频次或曝光范围，保留业务通路。" .

rcp:EXTRA_REVIEW a rcp:Decision ;
    rdfs:label "加审" ;
    rcp:baseScore 60 ;
    rcp:meaning "转人工或二次审核，通过后才可分发。" .

rcp:INTERCEPT a rcp:Decision ;
    rdfs:label "拦截" ;
    rcp:baseScore 80 ;
    rcp:meaning "直接阻断本次分发（重复洗稿、招聘侧飞单）。" .

rcp:BAN a rcp:Decision ;
    rdfs:label "封禁" ;
    rcp:baseScore 100 ;
    rcp:meaning "账号级处置，需与账号体系联动。" .
